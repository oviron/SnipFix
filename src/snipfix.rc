#include <winver.h>

#define SF_VERSION     1,0,0,0
#define SF_VERSION_STR "1.0.0"

1 24 "snipfix.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION SF_VERSION
PRODUCTVERSION SF_VERSION
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "SnipFix - exact screenshot colours with HDR on"
      VALUE "FileVersion", SF_VERSION_STR
      VALUE "ProductName", "SnipFix"
      VALUE "ProductVersion", SF_VERSION_STR
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "SnipFix.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
